pipeline {
    agent any

    tools {
        jdk 'jdk21'
        nodejs 'node23'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'

        DOCKER_IMAGE = 'kastrov/bms:latest'

        EKS_CLUSTER_NAME = 'kastro-eks'
        AWS_REGION = 'us-east-1'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git(
                    branch: 'main',
                    url: 'https://github.com/mokeshambati/Book-My-Show.git'
                )

                sh '''
                    echo "======================================"
                    echo "Git Checkout Completed"
                    echo "======================================"
                    ls -la
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                        echo "======================================"
                        echo "Running SonarQube Analysis"
                        echo "======================================"

                        $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=BMS \
                            -Dsonar.projectKey=BMS
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    echo "======================================"
                    echo "Checking SonarQube Quality Gate"
                    echo "======================================"

                    waitForQualityGate(
                        abortPipeline: false,
                        credentialsId: 'Sonar-token'
                    )
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    echo "======================================"
                    echo "Installing Node Dependencies"
                    echo "======================================"

                    cd bookmyshow-app

                    echo "Current directory:"
                    pwd

                    echo "Application files:"
                    ls -la

                    if [ -f package.json ]; then

                        echo "package.json found."

                        rm -rf node_modules
                        rm -f package-lock.json

                        npm install

                        echo "Node dependencies installed successfully."

                    else

                        echo "ERROR: package.json not found!"
                        exit 1

                    fi
                '''
            }
        }

        stage('OWASP FS Scan') {
            steps {
                echo "======================================"
                echo "Running OWASP Dependency-Check"
                echo "======================================"

                dependencyCheck(
                    additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
                    odcInstallation: 'dependency-check'
                )

                dependencyCheckPublisher(
                    pattern: '**/dependency-check-report.xml'
                )
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    echo "======================================"
                    echo "Running Trivy Filesystem Scan"
                    echo "======================================"

                    trivy fs . > trivyfs.txt

                    echo "Trivy filesystem scan completed."

                    echo "Report generated:"
                    ls -lh trivyfs.txt
                '''
            }
        }

        stage('Docker Check') {
            steps {
                sh '''
                    echo "======================================"
                    echo "Checking Docker"
                    echo "======================================"

                    echo "Docker location:"
                    which docker

                    echo "Docker version:"
                    docker --version

                    echo "Docker server/client:"
                    docker version
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {

                    echo "======================================"
                    echo "Docker Build & Push"
                    echo "======================================"

                    withDockerRegistry(
                        credentialsId: 'docker'
                    ) {

                        sh '''
                            echo "======================================"
                            echo "Building Docker Image"
                            echo "======================================"

                            docker build \
                                --no-cache \
                                -t $DOCKER_IMAGE \
                                -f bookmyshow-app/Dockerfile \
                                bookmyshow-app

                            echo "======================================"
                            echo "Docker Image Built Successfully"
                            echo "======================================"

                            docker images | grep kastrov/bms || true

                            echo "======================================"
                            echo "Pushing Image to Docker Hub"
                            echo "======================================"

                            docker push $DOCKER_IMAGE

                            echo "======================================"
                            echo "Docker Image Pushed Successfully"
                            echo "======================================"
                        '''
                    }
                }
            }
        }

        stage('Deploy to EKS Cluster') {
            steps {
                script {

                    sh '''
                        echo "======================================"
                        echo "AWS Account Verification"
                        echo "======================================"

                        aws sts get-caller-identity

                        echo "======================================"
                        echo "Configuring EKS Kubeconfig"
                        echo "======================================"

                        aws eks update-kubeconfig \
                            --name $EKS_CLUSTER_NAME \
                            --region $AWS_REGION

                        echo "======================================"
                        echo "Checking Kubernetes Cluster"
                        echo "======================================"

                        kubectl get nodes

                        echo "======================================"
                        echo "Deploying Kubernetes Resources"
                        echo "======================================"

                        kubectl apply -f deployment.yml
                        kubectl apply -f service.yml

                        echo "======================================"
                        echo "Checking Pods"
                        echo "======================================"

                        kubectl get pods -o wide

                        echo "======================================"
                        echo "Checking Services"
                        echo "======================================"

                        kubectl get svc

                        echo "======================================"
                        echo "EKS Deployment Completed"
                        echo "======================================"
                    '''
                }
            }
        }
    }

    post {

        always {
            echo "======================================"
            echo "Pipeline Completed"
            echo "Build Status: ${currentBuild.result}"
            echo "======================================"

            emailext(
                attachLog: true,
                subject: "${currentBuild.result}: BMS Jenkins Pipeline #${env.BUILD_NUMBER}",
                body: """
                    <h3>Book My Show CI/CD Pipeline</h3>

                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                    <p><b>Status:</b> ${currentBuild.result}</p>
                    <p><b>Docker Image:</b> ${env.DOCKER_IMAGE}</p>
                    <p><b>EKS Cluster:</b> ${env.EKS_CLUSTER_NAME}</p>
                    <p><b>AWS Region:</b> ${env.AWS_REGION}</p>
                    <p><b>Build URL:</b> ${env.BUILD_URL}</p>
                """,
                to: 'kastrokiran@gmail.com',
                attachmentsPattern: 'trivyfs.txt'
            )
        }
    }
}
